{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/addyosmani/agent-skills/schemas/mcp.schema.json",
  "type": "object",
  "required": ["schemaVersion", "servers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "servers": {
      "type": "array",
      "items": {"$ref": "#/$defs/server"}
    }
  },
  "$defs": {
    "environmentReference": {
      "type": "object",
      "required": ["source", "name"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "environment"},
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "required": {"type": "boolean"},
        "prefix": {"type": "string"}
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/environmentReference"}
    },
    "server": {
      "type": "object",
      "required": ["name", "id", "transport"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "transport": {"enum": ["stdio", "http"]},
        "command": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "url": {"type": "string", "pattern": "^https?://"},
        "env": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/environmentReference"}
        },
        "headers": {"$ref": "#/$defs/headers"}
      },
      "allOf": [
        {
          "if": {"properties": {"transport": {"const": "stdio"}}},
          "then": {
            "required": ["command", "args"],
            "not": {"anyOf": [{"required": ["url"]}, {"required": ["headers"]}]}
          }
        },
        {
          "if": {"properties": {"transport": {"const": "http"}}},
          "then": {
            "required": ["url"],
            "not": {"anyOf": [{"required": ["command"]}, {"required": ["args"]}]}
          },
          "else": {}
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/addyosmani/agent-skills/schemas/profile.schema.json",
  "type": "object",
  "required": ["name", "skills", "commands", "agents", "references", "evals", "mcp"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "description": {"type": "string"},
    "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "commands": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "agents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "mcp": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

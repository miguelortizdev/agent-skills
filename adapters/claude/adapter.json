{
  "host": "claude",
  "globalCommandSupport": "native",
  "status": "verified",
  "officialDocs": [
    "https://code.claude.com/docs/en/plugins",
    "https://code.claude.com/docs/en/plugins/components"
  ],
  "nativeDiscovery": {
    "skills": "skills",
    "agents": "agents",
    "commands": ["commands", ".claude/commands"],
    "hooks": "hooks",
    "mcp": ".mcp.json"
  },
  "mapping": {
    "skills": "native-plugin",
    "agents": "native-plugin",
    "commands": "native-plugin",
    "references": "packaged-with-canonical-assets",
    "evals": "native-plugin-evals",
    "hooks": "native-plugin-or-documented-fallback",
    "mcp": "documented-fallback"
  },
  "nativeCapabilities": ["skills", "commands", "agents", "references", "evals", "hooks"],
  "installDestinations": {
    "project": {
      "skills": ".claude/skills",
      "agents": ".claude/agents",
      "commands": ".claude/commands",
      "references": ".claude/references"
    },
    "global": {
      "skills": ".claude/skills",
      "agents": ".claude/agents",
      "commands": ".claude/commands",
      "references": ".claude/references"
    }
  },
  "commandRepresentation": {
    "format": "markdown",
    "extension": ".md",
    "filenameMap": {"plan": "plan"},
    "nativeSourceDirectory": ".claude/commands"
  },
  "mcpStrategy": "native-merge",
  "mcpConfig": {
    "format": "json",
    "projectPath": ".mcp.json",
    "globalPath": ".claude.json",
    "rootKey": "mcpServers",
    "envSyntax": "claude",
    "remoteType": "http"
  },
  "fallbacks": {
    "unsupported": "Keep the canonical asset and invoke it through its underlying Skill or documented manual configuration."
  }
}

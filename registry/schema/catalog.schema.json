{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/addyosmani/agent-skills/schemas/catalog.schema.json",
  "type": "object",
  "required": ["version", "sourceOfTruth", "assets"],
          "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "sourceOfTruth": {"const": "repository-root"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
          "required": ["id", "type", "path", "source", "enabled"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "type": {"enum": ["skill", "command", "agent", "reference", "eval", "hook", "script"]},
          "path": {"type": "string", "pattern": "^[^/].*[^/]$"},
          "source": {"enum": ["upstream", "custom"]},
          "enabled": {"type": "boolean"},
          "requires": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
          "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "contextual": {"const": true},
          "appliesWhen": {
            "type": "object",
            "required": ["any"],
            "additionalProperties": false,
            "properties": {
              "any": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {"type": "object", "required": ["type", "names"], "additionalProperties": false, "properties": {"type": {"const": "dependency"}, "file": {"type": "string"}, "names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
                    {"type": "object", "required": ["type", "paths"], "additionalProperties": false, "properties": {"type": {"const": "file"}, "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
                    {"type": "object", "required": ["type", "files", "patterns"], "additionalProperties": false, "properties": {"type": {"const": "text"}, "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}
                  ]
                }
              }
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"contextual": {"const": true}}},
          "then": {"required": ["appliesWhen"]}
        }]
      }
    }
  }
}
